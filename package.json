{
  "name": "multi-agent-studio",
  "version": "1.0.0",
  "description": "Multi-Agent Studio — Windows Desktop Studio for Multi-Agent AI Coding, Git & Dev Apps",
  "author": "Truong Duy Hung",
  "homepage": "https://github.com/Hungsilver/multi-agent-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hungsilver/multi-agent-studio.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "e2e": "node tests/e2e/launch.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.487.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.52.2",
    "mongodb": "^6.22.0",
    "oracledb": "^6.10.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.2.2",
    "sql.js": "^1.13.0",
    "tedious": "^19.2.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
